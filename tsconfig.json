{
	"compilerOptions": {
		"rootDir": "./",
		"outDir": "./build",
		"target": "es2020",
		"module": "CommonJS",
		"strict": false,
		"declaration": true,
		"noImplicitAny": true,
		"newLine": "lf",
		"sourceMap": true,
		"skipLibCheck": true
	},
	"include": ["./src/**/*"],
	"ts-node": {
		"logError": true
	},
	"compileOnSave": true
}
